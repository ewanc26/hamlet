<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless console harness: runs the sim with zero Godot dependency.
       CI uses this as the smoke run; developers use it for profiling. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../sim/Hamlet.Sim.csproj" />
  </ItemGroup>

</Project>
